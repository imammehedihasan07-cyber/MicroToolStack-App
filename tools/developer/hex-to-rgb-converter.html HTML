  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const hexInput = document.getElementById('hex-input');
      const colorBox = document.getElementById('color-box');

      const valRgb = document.getElementById('val-rgb');
      const valRgba = document.getElementById('val-rgba');
      const valChannels = document.getElementById('val-channels');

      const btnRandom = document.getElementById('btn-random');
      const btnClear = document.getElementById('btn-clear');
      const statusMsg = document.getElementById('status-msg');

      function convertHexToRgb() {
        let hex = hexInput.value.trim().replace(/^#/, '');

        if (hex.length === 3) {
          hex = hex.split('').map(x => x + x).join('');
        }

        const isValid = /^[0-9A-Fa-f]{6}$/.test(hex);

        if (!isValid) {
          colorBox.style.backgroundColor = 'transparent';
          valRgb.textContent = 'Invalid HEX Code';
          valRgb.style.color = '#ef4444';
          valRgba.textContent = 'Invalid HEX Code';
          valRgba.style.color = '#ef4444';
          valChannels.textContent = 'R: - | G: - | B: -';
          return;
        }

        const num = parseInt(hex, 16);
        const r = (num >> 16) & 255;
        const g = (num >> 8) & 255;
        const b = num & 255;

        const rgbStr = `rgb(${r}, ${g}, ${b})`;
        const rgbaStr = `rgba(${r}, ${g}, ${b}, 1)`;

        colorBox.style.backgroundColor = `#${hex}`;
        valRgb.textContent = rgbStr;
        valRgb.style.color = '#7ee787';
        valRgba.textContent = rgbaStr;
        valRgba.style.color = '#7ee787';
        valChannels.textContent = `R: ${r} | G: ${g} | B: ${b}`;
      }

      hexInput.addEventListener('input', convertHexToRgb);

      btnRandom.addEventListener('click', function() {
        const randomHex = '#' + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0').toUpperCase();
        hexInput.value = randomHex;
        convertHexToRgb();
      });

      btnClear.addEventListener('click', function() {
        hexInput.value = '';
        convertHexToRgb();
        hexInput.focus();
      });

      document.querySelectorAll('.btn-copy-small').forEach(btn => {
        btn.addEventListener('click', function() {
          const targetId = btn.getAttribute('data-target');
          const targetEl = document.getElementById(targetId);
          if (targetEl && targetEl.textContent && !targetEl.textContent.includes('Invalid')) {
            navigator.clipboard.writeText(targetEl.textContent).then(() => {
              statusMsg.style.display = 'inline';
              setTimeout(() => { statusMsg.style.display = 'none'; }, 2000);
            });
          }
        });
      });

      // Initial conversion
      convertHexToRgb();
    });
  </script>
